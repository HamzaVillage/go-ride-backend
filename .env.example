DB_HOST=127.0.0.1
DB_USER=nodeuser
DB_PASSWORD=StrongPassword123
DB_NAME=GO_DB_KINPL_LUCIDITY
DB_PORT=3306
PORT=4000
GMAIL_USER=
GMAIL_PASS=
UPLOAD_DIR=/var/www/html/uploads
BASE_UPLOAD_URL=https://kinetworksportal.com/uploads/

# JazzCash Payment Gateway Configuration
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
JAZZCASH_ENVIRONMENT=sandbox # sandbox or production

# Push Notification / Admin API Security Key
ADMIN_API_KEY=your_admin_secret_api_key_here

# Required for signing admin login JWTs (no development fallback is accepted).
JWT_SECRET=replace_with_a_long_random_server_secret


# Nearby driver dispatch: radius is sysconfigsetup.dispatch_radius_km in MySQL; location age is in seconds
DRIVER_PRESENCE_TTL_SECONDS=45

# Redis 6.2+ (private network only; use rediss:// for TLS and credentials as needed)
# Leave empty to use the database/socket fallback.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=goride:



# Enable only after applying db/migrations/add_ride_chat.sql
RIDE_CHAT_ENABLED=false

# Keep disabled for sensitive databases. Enables explicit admin profile/status
# updates and document uploads only; no changes are applied automatically.
ADMIN_DRIVER_PROFILE_WRITES_ENABLED=false
# Optional private identity-document storage (outside public UPLOAD_DIR).
# ADMIN_DRIVER_DOCUMENT_DIR=/secure/goride/driver-documents
